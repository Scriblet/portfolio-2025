# 📋 ARQUIVO .env DE EXEMPLO
# ===========================
# Copie este arquivo para .env e configure com seus valores reais.
# Este repositório só lê as variáveis abaixo: nada de EmailJS/Formspree.

# 📊 GOOGLE ANALYTICS (OPCIONAL EM DEV)
# -------------------------------------
VITE_GA_MEASUREMENT_ID=G-1234567890

# 📬 FORMULÁRIO DE CONTATO (SERVER-ONLY, NETLIFY FUNCTION)
# ---------------------------------------------------------
# URL do webhook do Discord usada por netlify/functions/contact.mjs.
# NUNCA use o prefixo VITE_ aqui: variáveis VITE_* são embutidas no bundle
# do navegador e ficariam públicas. Esta variável fica apenas no servidor.
# Configure em: Netlify → Site configuration → Environment variables.
# Para desenvolvimento local, `netlify dev` lê este valor do .env.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/seu-token-aqui

# Endpoint público chamado pelo navegador (VITE_ = vai para o bundle, é ok).
# Vazio = mesma origem (/api/contact), usado por `netlify dev`.
# No GitHub Pages (estático) aponte para o deploy das functions no Netlify:
# Ex.: https://lucas-contato.netlify.app/api/contact
VITE_CONTACT_ENDPOINT=

# Origens extras autorizadas a chamar a function via CORS, separadas por vírgula.
# GitHub Pages e lucasnonato.site já são padrão (ver docs/CONTACT-ENDPOINT.md).
# Use para previews de deploy, ex.: https://deploy-preview-123--site.netlify.app
CONTACT_ALLOWED_ORIGINS=
