# 📋 ARQUIVO .env DE EXEMPLO
# ===========================
# Copie este arquivo para .env e configure com seus valores reais

# 📊 GOOGLE ANALYTICS (OBRIGATÓRIO PARA PRODUÇÃO)
# -----------------------------------------------
VITE_GA_MEASUREMENT_ID=G-1234567890

# 📬 FORMULÁRIO DE CONTATO — SERVER-ONLY (NETLIFY FUNCTION)
# ---------------------------------------------------------
# URL do webhook do Discord usada por netlify/functions/contact.mjs.
# NUNCA use o prefixo VITE_ aqui: variáveis VITE_* são embutidas no bundle
# do navegador e ficariam públicas. Esta variável fica apenas no servidor.
# Configure em: Netlify → Site configuration → Environment variables.
# Para desenvolvimento local, `netlify dev` lê este valor do .env.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/seu-token-aqui

# 🌐 AMBIENTE
# -----------
NODE_ENV=production

# 🎨 TEMA (OPCIONAL)
# ------------------
VITE_PRIMARY_COLOR=#00bcd4
VITE_SECONDARY_COLOR=#9c27b0

# 📧 EMAIL/CONTATO (ESCOLHA UMA OPÇÃO)
# ------------------------------------
# Opção 1: EmailJS
VITE_EMAILJS_SERVICE_ID=service_abc123
VITE_EMAILJS_TEMPLATE_ID=template_xyz789
VITE_EMAILJS_PUBLIC_KEY=user_def456

# Opção 2: Formspree
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/abcd1234

# 🔗 REDES SOCIAIS
# ----------------
VITE_GITHUB_URL=https://github.com/seugithub
VITE_LINKEDIN_URL=https://www.linkedin.com/in/seuperfil/
VITE_INSTAGRAM_URL=https://instagram.com/seuinstagram
VITE_TWITTER_URL=https://twitter.com/seutwitter

# 🌍 SITE INFO
# ------------
VITE_BASE_URL=https://seusite.com
VITE_SITE_NAME=Seu Nome - Desenvolvedor Full-Stack
VITE_SITE_DESCRIPTION=Portfólio profissional de desenvolvimento web
VITE_SEO_KEYWORDS=desenvolvedor,web,react,typescript,portfolio
VITE_AUTHOR=Seu Nome Completo

# 🔧 DESENVOLVIMENTO (OPCIONAL)
# -----------------------------
VITE_DEV_PORT=3000
VITE_DEV_HOST=localhost

# 📱 PWA (SE IMPLEMENTAR)
# ----------------------
VITE_PWA_NAME=Meu Portfolio
VITE_PWA_SHORT_NAME=Portfolio
VITE_PWA_THEME_COLOR=#181823
VITE_PWA_BACKGROUND_COLOR=#000000

# 📊 ANALYTICS EXTRAS (OPCIONAL)
# ------------------------------
VITE_GTM_ID=GTM-ABCD123
VITE_HOTJAR_ID=1234567

# 🎯 APIs (SE USAR)
# -----------------
VITE_GITHUB_API_TOKEN=ghp_seu_token_aqui
VITE_API_BASE_URL=https://api.seusite.com

# 🔐 SEGURANÇA
# ------------
VITE_CORS_ORIGINS=http://localhost:3000,https://seusite.com

# 🚨 DEBUG (DESENVOLVIMENTO)
# --------------------------
VITE_DEBUG_MODE=false
VITE_GA_DEBUG=false
VITE_PERFORMANCE_DEBUG=false
